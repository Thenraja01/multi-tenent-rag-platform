# App Settings
APP_NAME=NexusRAG Multi-Domain Enterprise Platform
APP_VERSION=2.0.0
DEBUG=True

# Platform SuperAdmin Credentials (.env Seed Config)
SUPERADMIN_EMAIL=superadmin@platform.com
SUPERADMIN_PASSWORD=SuperAdminPass123!
SUPERADMIN_NAME=Nexus Platform SuperAdmin

# Database Settings (PostgreSQL + pgvector)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_123
POSTGRES_DB=rag_multi_domain_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://admin:admin_123@localhost:5432/rag_multi_domain_db
SYNC_DATABASE_URL=postgresql://admin:admin_123@localhost:5432/rag_multi_domain_db
VECTOR_DIMENSION=1536

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Keycloak SSO Settings
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_123
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=nexus_rag_client
KEYCLOAK_CLIENT_SECRET=secret

# File Storage Provider (local | minio | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password123
MINIO_ENDPOINT=localhost:9000
S3_BUCKET_NAME=nexusrag-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Vector Database (pgvector | chroma)
VECTOR_STORE_PROVIDER=pgvector
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# JWT Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Pure Vector RAG Hyperparameters
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
